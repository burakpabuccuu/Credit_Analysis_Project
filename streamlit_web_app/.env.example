# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Gemini Model Fallback Zinciri (virgülle ayrılmış — ilk model kotaya takılırsa sıradaki denenir)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemini-2.5-flash-lite

# Groq Fallback Model
GROQ_MODEL=qwen/qwen3.8-27b

# Risk Threshold (0-100 arası, bu değerin üstü KREDİ RED)
RISK_THRESHOLD=35
